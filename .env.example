# 로컬 실행용 환경변수 예시. 복사해서 .env.local로 저장하고 값을 채운다 (.env.local은 커밋하지 않는다).
# 값이 없으면 AI 없이 규칙 모드로 동작한다.

# Gemini API 키. 비우면 AI 없이 규칙 기반으로만 추천한다.
GEMINI_API_KEY=
# Gemini 모델 이름. 비우면 코드 기본값.
GEMINI_MODEL=
# AI 공급자: gemini 또는 none. 로컬 dev 서버(npm run dev)는 비어 있으면 none.
LLM_PROVIDER=
# rules로 두면 키가 있어도 AI를 부르지 않는다 (규칙 모드 강제).
RECOMMENDATION_MODE=
# 주문자 비밀번호에 사용하는 서버 전용 키. 가입한 계정의 로그인을 위해 같은 값을 유지한다.
BAPPILOT_PASSWORD_PEPPER=
# 로컬 dev 서버 포트 (기본 4173)
PORT=
# 로딩 화면 확인용: API 응답을 일부러 늦추는 밀리초 (예: 3000)
DEV_DELAY_MS=
